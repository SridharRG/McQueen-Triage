# McQueen runtime config. Copy to mcqueen.env and fill in. Never commit mcqueen.env.

# ── LLM (Groq, via rig) ─────────────────────────────────────────────────────
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# Provider tokens/minute cap to pace under (8000 = Groq free/on-demand tier for
# gpt-oss-120b). Raise on a paid tier; 0 disables pacing.
LLM_TPM_LIMIT=8000
# Model calls per triage including the final report call; tool use needs >= 2.
LLM_MAX_TURNS=4
LLM_TOOLS=true
# Pre-assembled context per prompt (characters, ~3.2 per token).
LLM_CONTEXT_BUDGET_CHARS=16000

# ── triage policy ───────────────────────────────────────────────────────────
AUTO_TRIAGE=true
TRIAGE_MAX_PER_HOUR=20
TRIAGE_SETTLE_SECS=8
TRIAGE_CONCURRENCY=1

# ── public URL + access ─────────────────────────────────────────────────────
PUBLIC_URL=https://triage.regere.ai
# Optional in-app basic auth (skip if Caddy does basic_auth). /api/health and
# /api/ingest/* stay open either way.
AUTH_USER=
AUTH_PASSWORD=
# Shared key the browser SDK sends as x-mcqueen-key (like a Sentry DSN: public-ish,
# stops drive-by posts). Comma-separated origins allowed to post frontend errors.
INGEST_KEY=
INGEST_ALLOWED_ORIGINS=https://launchpad-headless-dev.regere.ai,https://siemens-uat.regere.ai

# ── alerts ──────────────────────────────────────────────────────────────────
GOOGLE_CHAT_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
NOTIFY_MIN_SEVERITY=high

# ── optional sources ────────────────────────────────────────────────────────
# Jaeger/Tempo-compatible query API, merged into the request journey when set.
JAEGER_URL=

# ── storage ─────────────────────────────────────────────────────────────────
RETENTION_HOURS=72
MAX_LOG_ROWS=3000000
# On first start, ingest this much history per container.
BACKFILL_MINUTES=30
